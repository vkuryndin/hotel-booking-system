### 9 — Вход с временным паролем: 200
POST http://localhost:8080/api/users/login
Content-Type: application/json

{
  "email": "forced-change-test@example.com",
  "password": "TemporaryPassword123!"
}

> {%
    client.test("9: Login with temporary password", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.passwordChangeRequired === true,
            "Password change must be required");
    });
    client.global.set("temporaryToken", response.body.accessToken);
%}


