### S4-06 — Нет X-Trace-Id: Gateway генерирует UUID
GET {{baseUrl}}/api/hotels
Authorization: Bearer {{adminToken}}

> {%
    client.test("S4-06: auto-generated UUID", () => {
        client.assert(response.status === 200);
        const id = response.headers.valueOf("X-Trace-Id");
        client.assert(
            /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(id)
        );
    });
%}


### S4-07 — Некорректный traceId заменяется новым
GET {{baseUrl}}/api/hotels
Authorization: Bearer {{adminToken}}
X-Trace-Id: invalid-trace-id

> {%
    client.test("S4-07: invalid traceId replaced", () => {
        client.assert(response.status === 200);
        const id = response.headers.valueOf("X-Trace-Id");
        client.assert(id !== "invalid-trace-id");
        client.assert(
            /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(id)
        );
    });
%}


