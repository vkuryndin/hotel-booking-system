@baseUrl = http://localhost:8080
@qaFailureCheckIn = 2054-07-10
@qaFailureCheckOut = 2054-07-12
@qaRoomId = 1

### Register user
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "MyPassword123",
  "username": "vova",
  "lastName": "vova",
  "firstName": "vova"
}

### Register duplicate user - expected 409
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "MyPassword123"
}

### Register with invalid email - expected 400
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "email": "invalid-email",
  "password": "MyPassword123"
}

### Login
