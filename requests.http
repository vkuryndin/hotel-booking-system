### S4-04 — Повторное бронирование: 409 с traceId
POST {{baseUrl}}/api/bookings
Authorization: Bearer {{adminToken}}
X-Trace-Id: 44444444-4444-4444-8444-444444444444
Idempotency-Key: {{$uuid}}
Content-Type: application/json

{
  "roomId": {{s12Suite2}},
  "guestCount": 1,
  "checkIn": "2051-06-10",
  "checkOut": "2051-06-12"
}

> {%
    client.test("S4-04: conflict traceId", () => {
        client.assert(response.status === 409);
        client.assert(
            response.headers.valueOf("X-Trace-Id") ===
            "44444444-4444-4444-8444-444444444444"
        );
        client.assert(
            response.body.traceId ===
            "44444444-4444-4444-8444-444444444444"
        );
    });
