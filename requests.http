PATCH {{baseUrl}}/api/bookings/{{qaFailureBookingId}}/cancel
Authorization: Bearer {{adminToken}}

> {%
    client.test("QA-18: Cancellation failed safely", function() {
        client.assert(response.status === 503,
            "Expected 503, got " + response.status);
        client.assert(
            response.body.code === "BOOKING_SAGA_UNAVAILABLE",
            "Unexpected error: " + response.body.code
        );
    });
%}


### QA-19 — Проверяем сохранённое состояние
### Ожидаем 200 CANCELLING

GET {{baseUrl}}/api/bookings/{{qaFailureBookingId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("QA-19: Cancellation pending", function() {
        client.assert(response.status === 200);
        client.assert(response.body.status === "CANCELLING",
            "Expected CANCELLING, got " + response.body.status);
    });
%}


