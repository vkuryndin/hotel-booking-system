### ==========================================
### STAGE 23 — SAGA / COUNTER TESTS
### ==========================================


@qaCheckIn = 2054-06-10
@qaCheckOut = 2054-06-12
@qaGuestCount = 1


### QA-01 — Создаём отдельный тестовый отель
### Ожидаем: 201, возвращается id

POST {{baseUrl}}/api/hotels
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "QA Saga {{$uuid}}",
  "address": "Yerevan, QA Test Street"
}

> {%
    client.test("QA-01: Hotel created", function() {
        client.assert(response.status === 201,
            "Expected 201, got " + response.status);
        client.assert(Number(response.body.id) > 0,
            "Hotel ID missing");
    });
    if (response.status === 201) {
        client.global.set("qaHotelId", response.body.id);
    }
%}


### QA-02 — Создаём номер в тестовом отеле
### Ожидаем: 201, сохраняем qaRoomId

POST {{baseUrl}}/api/rooms
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "hotelId": {{qaHotelId}},
  "number": "QA101",
  "category": "STANDARD",
  "capacity": 2,
  "pricePerNight": 150
}

> {%
    client.test("QA-02: Room created", function() {
        client.assert(response.status === 201,
            "Expected 201, got " + response.status);
        client.assert(Number(response.body.id) > 0,
            "Room ID missing");
        client.assert(
            Number(response.body.hotelId) ===
            Number(client.global.get("qaHotelId")),
            "Wrong hotel ID"
        );
    });
    if (response.status === 201) {
        client.global.set("qaRoomId", response.body.id);
    }
%}


### QA-03 — Проверяем начальный счётчик
### Ожидаем: 200, timesBooked = 0

GET {{baseUrl}}/api/rooms/{{qaRoomId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("QA-03: Initial counter is zero", function() {
        client.assert(response.status === 200);
        client.assert(Number(response.body.timesBooked) === 0,
            "Expected timesBooked=0, got " +
            response.body.timesBooked);
    });
%}


### QA-04 — Создаём первое бронирование
### Ожидаем: 201, CONFIRMED
### Сохраняем qaBookingId

POST {{baseUrl}}/api/bookings
Authorization: Bearer {{adminToken}}
Idempotency-Key: {{$uuid}}
Content-Type: application/json

{
  "roomId": {{qaRoomId}},
  "checkIn": "{{qaCheckIn}}",
  "checkOut": "{{qaCheckOut}}",
  "guestCount": {{qaGuestCount}}
}

> {%
    client.test("QA-04: Booking confirmed", function() {
        client.assert(response.status === 201,
            "Expected 201, got " + response.status);
        client.assert(response.body.status === "CONFIRMED",
            "Expected CONFIRMED");
        client.assert(Number(response.body.roomId) ===
            Number(client.global.get("qaRoomId")),
            "Wrong room ID");
    });
    if (response.status === 201) {
        client.global.set("qaBookingId", response.body.id);
    }
%}


