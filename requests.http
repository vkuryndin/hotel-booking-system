GET {{baseUrl}}/api/rooms/{{qaRoomId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("QA-25: Final counter is 4", function() {
        client.assert(response.status === 200);
        client.assert(Number(response.body.timesBooked) === 2,
            "Expected 4, got " + response.body.timesBooked);
    });
%}



### ADMIN-01 — Получаем ID текущего администратора
### Ожидаем 200 и role=ADMIN
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{adminToken}}

> {%
    client.test("ADMIN-01", () => {
        client.assert(response.status === 200);
        client.assert(response.body.role === "ADMIN");
        client.global.set("guardAdminId", response.body.id);
    });
%}


### ADMIN-02 — Запрещаем понижение себя
### Ожидаем 403
PATCH {{baseUrl}}/api/users/{{guardAdminId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "USER"
}

> {%
    client.test("ADMIN-02: Self-demotion blocked", () => {
        client.assert(response.status === 403);
    });
%}


### ADMIN-03 — Запрещаем удаление себя
### Ожидаем 403
DELETE {{baseUrl}}/api/users/{{guardAdminId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("ADMIN-03: Self-deletion blocked", () => {
        client.assert(response.status === 403);
    });
%}


### ADMIN-04 — Создаём второго администратора
### Ожидаем 201
POST {{baseUrl}}/api/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "admin-guard-test@example.com",
  "password": "TestPassword123!",
  "role": "ADMIN",
  "username": "admin_guard_test",
  "firstName": "Guard",
  "lastName": "Test"
}

> {%
    client.test("ADMIN-04: Second admin created", () => {
        client.assert(response.status === 201);
        client.global.set("guardSecondAdminId", response.body.id);
    });
%}


### ADMIN-05 — Понижаем второго ADMIN до USER
### Ожидаем 200 и role=USER
PATCH {{baseUrl}}/api/users/{{guardSecondAdminId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "USER"
}

> {%
    client.test("ADMIN-05: Other admin demoted", () => {
        client.assert(response.status === 200);
        client.assert(response.body.role === "USER");
    });
%}


### ADMIN-06 — Удаляем бывшего ADMIN
### Ожидаем 200 USER_DELETED
DELETE {{baseUrl}}/api/users/{{guardSecondAdminId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("ADMIN-06: User deleted", () => {
        client.assert(response.status === 200);
        client.assert(response.body.code === "USER_DELETED");
    });
%}


### ADMIN-07 — Проверяем, что основной ADMIN остался
### Ожидаем 200 и role=ADMIN
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{adminToken}}

> {%
    client.test("ADMIN-07: Main admin preserved", () => {
        client.assert(response.status === 200);
        client.assert(response.body.role === "ADMIN");
        client.assert(
            Number(response.body.id) ===
            Number(client.global.get("guardAdminId"))
        );
    });
%}

### A20-01 создать отель: 201
POST {{baseUrl}}/api/hotels
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Case Test Hotel 20261029",
  "address": "Case Test Street 20261029"
}

> {%
    client.test("A20-01 hotel created", () => {
        client.assert(response.status === 201);
        client.global.set("a20Hotel1", response.body.id);
    });
%}

### A20-02  тот же отель, другой регистр: 409
POST {{baseUrl}}/api/hotels
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "CASE TEST HOTEL 20261029",
  "address": "CASE TEST STREET 20261029"
}

> {%
    client.test("A20-02 duplicate rejected", () => {
        client.assert(response.status === 409);
        client.assert(response.body.code === "HOTEL_ALREADY_EXISTS");
    });
%}

### A20-03 создать другой отель: 201
POST {{baseUrl}}/api/hotels
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Second Case Test Hotel 20261029",
  "address": "Second Case Street 20261029"
}

> {%
    client.test("A20-03 second hotel created", () => {
        client.assert(response.status === 201);
        client.global.set("a20Hotel2", response.body.id);
    });
%}

### A20-04 попытка переименовать в дубликат: 409
PUT {{baseUrl}}/api/hotels/{{a20Hotel2}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "CASE TEST HOTEL 20261029",
  "address": "CASE TEST STREET 20261029"
}

> {%
    client.test("A20-04 duplicate update rejected", () => {
        client.assert(response.status === 409);
        client.assert(response.body.code === "HOTEL_ALREADY_EXISTS");
    });
%}

### A20-05 после ошибки второй отель не изменился: 200
GET {{baseUrl}}/api/hotels/{{a20Hotel2}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("A20-05 hotel unchanged", () => {
        client.assert(response.status === 200);
        client.assert(response.body.name ===
            "Second Case Test Hotel 20261029");
    });
%}

