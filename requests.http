@baseUrl = http://localhost:8080

### Register user
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "MyPassword123"
}

### Register duplicate user - expected 409
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "MyPassword123"
}

### Register with invalid email - expected 400
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "email": "invalid-email",
  "password": "MyPassword123"
}

### Login
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "MyPassword123"
}

> {%
    client.global.set("accessToken", response.body.accessToken);
%}


### Create hotel without JWT — expected 401
POST {{baseUrl}}/api/hotels
Content-Type: application/json

{
  "name": "Test Hotel",
  "address": "Yerevan, Armenia"
}

### Create hotel as USER — expected 403
POST {{baseUrl}}/api/hotels
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Test Hotel",
  "address": "Yerevan, Armenia"
}

### Login as ADMIN
POST http://localhost:8080/api/users/login
Content-Type: application/json

{
  "email": "admin@hotelbooking.com",
  "password": "Gefsbizd19!"
}

> {%
    client.global.set("adminToken", response.body.accessToken);
%}

# should be redone everytime i restart hotelservice

### Create hotel as ADMIN — expected 201
POST {{baseUrl}}/api/hotels
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Ararat Hotel",
  "address": "Yerevan, Armenia"
}

### Create room as ADMIN
POST {{baseUrl}}/api/rooms
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "hotelId": 1,
  "number": "101"
}

### Duplicate room — expected 409
POST {{baseUrl}}/api/rooms
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "hotelId": 1,
  "number": "101"
}

### Create room in non-existing hotel — expected 404
POST {{baseUrl}}/api/rooms
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "hotelId": 999999,
  "number": "202"
}

### Get rooms by hotel — no JWT required
GET {{baseUrl}}/api/rooms?hotelId=1

### Получить номер по ID — ожидаем 200
GET {{baseUrl}}/api/rooms/1

### Получить несуществующий номер — ожидаем 404
GET {{baseUrl}}/api/rooms/999999

### Отключить номер — ожидаем 200
PATCH {{baseUrl}}/api/rooms/1/availability
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "available": false
}

### Получить доступные номера — ожидаем 200
GET {{baseUrl}}/api/rooms/available?hotelId=1


### Создание бронирования
POST {{baseUrl}}/api/bookings
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "roomId":1,
  "checkIn": "2026-12-10",
  "checkOut": "2026-12-13"
}

### возврат номера в available
PATCH {{baseUrl}}/api/rooms/1/availability
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "available": true
}

### Мои бронирования
GET {{baseUrl}}/api/bookings/my
Authorization: Bearer {{adminToken}}

### Получить бронирование по ID
GET {{baseUrl}}/api/bookings/1
Authorization: Bearer {{adminToken}}

### Попытка получить чужое бронирование
GET {{baseUrl}}/api/bookings/1
Authorization: Bearer {{accessToken}}

### попытка получить бронирования без авторизации
GET {{baseUrl}}/api/bookings/my

### Подтвердить бронирование
PATCH {{baseUrl}}/api/bookings/1/confirm
Authorization: Bearer {{adminToken}}

### Отменить бронирование
PATCH {{baseUrl}}/api/bookings/1/cancel
Authorization: Bearer {{adminToken}}

### Все бронирования (ADMIN)
GET {{baseUrl}}/api/bookings?page=0&size=10
Authorization: Bearer {{adminToken}}


### Все бронирования
GET {{baseUrl}}/api/bookings?page=0&size=10
Authorization: Bearer {{adminToken}}

### Только ожидающие подтверждения
GET {{baseUrl}}/api/bookings?status=PENDING&page=0&size=10
Authorization: Bearer {{adminToken}}

### Только подтверждённые
GET {{baseUrl}}/api/bookings?status=CONFIRMED
Authorization: Bearer {{adminToken}}


### Резервирование номера
POST {{baseUrl}}/api/rooms/1/confirm-availability
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reservationId": "123e4567-e89b-42d3-a456-426614174000",
  "checkIn": "2026-12-20",
  "checkOut": "2026-12-23"
}

### Освобождение резервирования
POST {{baseUrl}}/api/rooms/1/release
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reservationId": "123e4567-e89b-42d3-a456-426614174000"
}