# =====================================================================================
# РАЗДЕЛ 14. Отказы, Eureka, ручной Recovery и перезапуски (только отдельно)
# =====================================================================================

# ОТДЕЛЬНЫЙ БЛОК: отключения, рестарты и ожидание восстановления.
# После каждого сбоя возвращайте сервисы в рабочее состояние и при необходимости повторяйте начальную авторизацию.
# Запросы в Eureka меняют реальный статус инстансов и могут дать другие ответы при ином состоянии кластера.

### 14.001 — Информация о Hotel Service в Eureka — ожидаем HTTP 200
# Источник: requests.http, тест №40.
# ВНИМАНИЕ: проверка зависит от состояния Eureka/сервисов; выполняйте только после подготовки, описанной в сценарии.
GET http://localhost:8761/eureka/apps/HOTEL-SERVICE
Accept: application/json

> {%
client.test('Информация о Hotel Service в Eureka — HTTP 200', function() {
  client.assert(response.status === 200, "Ожидали 200, получили " + response.status);
  const rawInstances = response.body.application && response.body.application.instance;
  const instances = Array.isArray(rawInstances) ? rawInstances : [rawInstances];
  const instance = instances.find(item => item && item.instanceId);
  client.assert(!!instance, "Eureka не вернула instanceId для HOTEL-SERVICE");
  if (instance) client.global.set("initialHotelInstanceId", instance.instanceId);
});
%}

### 14.002 — Исключить Hotel Service из маршрутизации Eureka — ожидаем HTTP 200
# Источник: requests.http, тест №41.
# ВНИМАНИЕ: проверка зависит от состояния Eureka/сервисов; выполняйте только после подготовки, описанной в сценарии.
PUT http://localhost:8761/eureka/apps/HOTEL-SERVICE/{{initialHotelInstanceId}}/status?value=OUT_OF_SERVICE

> {%
client.test('Исключить Hotel Service из маршрутизации Eureka — HTTP 200', function() {
  client.assert(response.status === 200, "Ожидали 200, получили " + response.status);
});
%}

