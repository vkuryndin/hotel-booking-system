### 03.001 — Создание пользователя — ожидаем HTTP 201
POST {{baseUrl}}/api/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "admin-check-03@example.com",
  "password": "Test12345!",
  "role": "USER",
  "username": "admincheck03",
  "firstName": "Admin",
  "lastName": "Check"
}

> {%
client.test('Создание пользователя — HTTP 201', function() {
  client.assert(response.status === 201, "Ожидали 201, получили " + response.status);
  client.assert(Number(response.body.id) > 0, 'ID пользователя отсутствует');
});
if (response.status === 201) client.global.set('section03UserId', response.body.id);
%}

### 03.002 — Список пользователей (200) — ожидаем HTTP 200
GET {{baseUrl}}/api/users
Authorization: Bearer {{adminToken}}

> {%
client.test('Список пользователей (200) — HTTP 200', function() {
  client.assert(response.status === 200, "Ожидали 200, получили " + response.status);
});
%}

### 03.002a — Поиск пользователей на сервере по username — ожидаем HTTP 200
GET {{baseUrl}}/api/users?page=0&size=20&q=admincheck03
Authorization: Bearer {{adminToken}}

> {%
client.test('Поиск ADMIN пользователей через q — HTTP 200', function() {
  client.assert(response.status === 200, "Ожидали 200, получили " + response.status);
  client.assert(Array.isArray(response.body.content), "Ожидалась страница пользователей");
  client.assert(response.body.content.some(u => Number(u.id) === Number(client.global.get('section03UserId'))),
    "Не найден созданный пользователь");
});
%}

