  "password": "1234567890!!@d"
}

> {%
client.test('Демо-пользователь 1 — HTTP 200', () => client.assert(response.status === 200, "Ожидали 200, получили " + response.status));
if (response.status === 200) {
  client.global.set("demoUserToken", response.body.accessToken);
}
%}

### 09.002 — Список отелей с JWT демо-пользователя — ожидаем HTTP 200
# Источник: requests.http, тест №338.
GET {{baseUrl}}/api/hotels
Authorization: Bearer {{demoUserToken}}

> {%
