### 12.022 — Статистика до отмены: одно активное бронирование — ожидаем HTTP 200
# Сначала выполните запросы 12.015–12.021 без перезапуска H2 и войдите как ADMIN.
# Техническую запись освобождения нельзя создать через Gateway: внутренний /release требует SERVICE JWT.
# It is tested in HotelStatisticsTombstoneJpaTest.
GET {{baseUrl}}/api/hotels/{{s15HotelId}}/statistics
Authorization: Bearer {{adminToken}}

> {%
    client.test('Статистика до отмены: одно активное бронирование — HTTP 200', () => {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(Number(response.body.totalReservations) === 1);
        client.assert(Number(response.body.reservedReservations) === 1);
        client.assert(Number(response.body.releasedReservations) === 0);
        client.assert(Number(response.body.tombstoneReservations) === 0);
        client.assert(Number(response.body.totalTimesBooked) === 1);
    });
%}

