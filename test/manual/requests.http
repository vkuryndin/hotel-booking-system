# Отдельная серия из idempotency-tests.http (8 шагов). Сохраняем как дополнительную
# проверку replay, конфликтов, соседних дат и отмены. Используется номер {{s10Room1}}, созданный в S10-02;
# сначала выполните весь блок S10, не удаляя номер.
# Выполняйте один раз на чистой H2 либо смените четыре ключа идемпотентности.

### 05.I01 — ТЕСТ 1 — Создаём бронирование — ожидаем HTTP 201
# Источник: idempotency-tests.http, шаг 1.
POST {{baseUrl}}/api/bookings
Authorization: Bearer {{adminToken}}
Idempotency-Key: {{idemKeyA}}
Content-Type: application/json

{
  "roomId": {{s10Room1}},
  "checkIn": "{{idemCheckIn}}",
  "checkOut": "{{idemCheckOut}}"
}

> {%
    client.test('05.I01: ТЕСТ 1 — Создаём бронирование — HTTP 201', function() {
        client.assert(response.status === 201);
        client.assert(response.body.status === "CONFIRMED");
    });
    client.global.set("idemBookingId", response.body.id);
%}

### 05.I02 — ТЕСТ 2 — Повтор того же запроса — ожидаем HTTP 201
# Источник: idempotency-tests.http, шаг 2.
POST {{baseUrl}}/api/bookings
Authorization: Bearer {{adminToken}}
Idempotency-Key: {{idemKeyA}}
Content-Type: application/json

{
  "roomId": {{s10Room1}},
  "checkIn": "{{idemCheckIn}}",
  "checkOut": "{{idemCheckOut}}"
}

> {%
    client.test('05.I02: ТЕСТ 2 — Повтор того же запроса — HTTP 201', function() {
        client.assert(response.status === 201);
        client.assert(response.body.status === "CONFIRMED");
        client.assert(String(response.body.id) ===
            String(client.global.get("idemBookingId")));
    });
%}

### 05.I03 — ТЕСТ 3 — Тот же ключ, другие даты — ожидаем HTTP 409
# Источник: idempotency-tests.http, шаг 3.
POST {{baseUrl}}/api/bookings
Authorization: Bearer {{adminToken}}
Idempotency-Key: {{idemKeyA}}
Content-Type: application/json

{
  "roomId": {{s10Room1}},
  "checkIn": "{{idemCheckIn}}",
  "checkOut": "2027-04-14"
}

> {%
    client.test('05.I03: ТЕСТ 3 — Тот же ключ, другие даты — HTTP 409', function() {
        client.assert(response.status === 409);
        client.assert(response.body.code === "IDEMPOTENCY_KEY_CONFLICT");
    });
%}

