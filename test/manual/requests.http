### 08.017 — MOST_EXPENSIVE, 3 гостя — ожидаем HTTP 200
# MOST_EXPENSIVE, 3 гостя
GET {{baseUrl}}/api/rooms/recommend?hotelId={{s12HotelId}}&checkIn=2040-02-10&checkOut=2040-02-12&strategy=MOST_EXPENSIVE&guestCount=3
Authorization: Bearer {{adminToken}}

> {%
    client.test('MOST_EXPENSIVE, 3 гостя — HTTP 200', () => {
        client.assert(response.status === 200);
        const actual = response.body.map(r => r.id);
        const expected = [
            Number(client.global.get("s12Suite4")),
            Number(client.global.get("s12Suite3")),
            Number(client.global.get("s12Deluxe")),
            Number(client.global.get("s12Standard"))
        ];
        client.assert(
            JSON.stringify(actual) === JSON.stringify(expected),
            "Wrong ranking: " + JSON.stringify(actual)
        );
    });
%}

