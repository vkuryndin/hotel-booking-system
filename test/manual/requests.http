  client.assert(response.status === 200, "Ожидали 200, получили " + response.status);
  client.assert(Array.isArray(response.body.content), "Ожидалась страница отелей");
  client.assert(response.body.content.length > 0, "Нужен хотя бы один отель");
});
if (response.status === 200 && response.body.content && response.body.content.length > 0) {
  client.global.set("demoBrowseHotelId", response.body.content[0].id);
}
%}

