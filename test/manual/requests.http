### 12.022 — S16-01 — Статистика до отмены: одно активное бронирование — ожидаем HTTP 200
# Источник: requests.http, тест №436.
# Execute S15-01...S15-07 first without restarting H2, and log in as ADMIN.
# Technical tombstone cannot be created through Gateway: internal /release requires SERVICE JWT.
# It is tested in HotelStatisticsTombstoneJpaTest.
GET {{baseUrl}}/api/hotels/{{s15HotelId}}/statistics
Authorization: Bearer {{adminToken}}

> {%
    client.test('1. S16-01 — Статистика до отмены: одно активное бронирование — HTTP 200', () => {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(Number(response.body.totalReservations) === 1);
        client.assert(Number(response.body.reservedReservations) === 1);
        client.assert(Number(response.body.releasedReservations) === 0);
        client.assert(Number(response.body.tombstoneReservations) === 0);
        client.assert(Number(response.body.totalTimesBooked) === 1);
    });
%}

