# =====================================================================================
# РАЗДЕЛ 11. Saga: контрольный сценарий без отключения сервисов
# =====================================================================================

### 11.001 — QA-01 — Создаём отдельный тестовый отель — ожидаем HTTP 201
# Источник: requests.http, тест №391.
# QA-01 — Создаём отдельный тестовый отель
POST {{baseUrl}}/api/hotels
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "QA Saga {{$uuid}}",
  "address": "Yerevan, QA Test Street"
}

> {%
    client.test('1. QA-01 — Создаём отдельный тестовый отель — HTTP 201', function() {
        client.assert(response.status === 201,
            "Expected 201, got " + response.status);
        client.assert(Number(response.body.id) > 0,
            "Hotel ID missing");
    });
    if (response.status === 201) {
        client.global.set("qaHotelId", response.body.id);
    }
%}

