### 09.001 — Демо-пользователь 1 — ожидаем HTTP 200
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
  "email": "anna.petrova@example.com",
  "password": "1234567890!!@d"
}

> {%
client.test('Демо-пользователь 1 — HTTP 200', () => client.assert(response.status === 200, "Ожидали 200, получили " + response.status));
if (response.status === 200) {
  client.global.set("demoUserToken", response.body.accessToken);
}
%}

### 09.002 — Список отелей с JWT демо-пользователя — ожидаем HTTP 200
GET {{baseUrl}}/api/hotels
Authorization: Bearer {{demoUserToken}}

> {%
client.test('Список отелей с JWT демо-пользователя — HTTP 200', function() {
  client.assert(response.status === 200, "Ожидали 200, получили " + response.status);
  client.assert(Array.isArray(response.body.content), "Ожидалась страница отелей");
  client.assert(response.body.content.length > 0, "Нужен хотя бы один отель");
});
if (response.status === 200 && response.body.content && response.body.content.length > 0) {
  client.global.set("demoBrowseHotelId", response.body.content[0].id);
}
%}

