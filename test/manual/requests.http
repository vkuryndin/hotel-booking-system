### 05.014 — После отмены timesBooked=0 у обоих, оба доступны — ожидаем HTTP 200
# Источник: requests.http, тест №202.
# S10-14 — После отмены доступны оба: 200
GET {{baseUrl}}/api/rooms/recommend?hotelId={{s10Hotel}}&checkIn=2031-03-10&checkOut=2031-03-12
Authorization: Bearer {{adminToken}}

> {%
client.test('После отмены оба номера свободны, timesBooked=0 — HTTP 200', function() {
  client.assert(response.status === 200, "Ожидали 200, получили " + response.status);
  client.assert(Array.isArray(response.body), "Ожидался список рекомендуемых номеров");
  client.assert(response.body.length === 2, "Ожидались оба номера");
  client.assert(response.body.every(r => Number(r.timesBooked) === 0),
    "Отменённые бронирования не должны учитываться в timesBooked");
});
%}

