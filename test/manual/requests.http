# =====================================================================================
# РАЗДЕЛ 11. Saga: контрольный сценарий без отключения сервисов
# =====================================================================================

### 11.001 — Создаём отдельный тестовый отель — ожидаем HTTP 201
# Создаём отдельный тестовый отель
POST {{baseUrl}}/api/hotels
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "QA Saga {{$uuid}}",
  "address": "Yerevan, QA Test Street"
}

> {%
    client.test('Создаём отдельный тестовый отель — HTTP 201', function() {
        client.assert(response.status === 201,
            "Expected 201, got " + response.status);
        client.assert(Number(response.body.id) > 0,
            "Hotel ID missing");
    });
    if (response.status === 201) {
        client.global.set("qaHotelId", response.body.id);
    }
%}

### 11.002 — Создаём номер в тестовом отеле — ожидаем HTTP 201
# Создаём номер в тестовом отеле
POST {{baseUrl}}/api/rooms
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "hotelId": {{qaHotelId}},
  "number": "QA101",
  "category": "STANDARD",
  "capacity": 2,
  "pricePerNight": 150
}

> {%
    client.test('Создаём номер в тестовом отеле — HTTP 201', function() {
        client.assert(response.status === 201,
            "Expected 201, got " + response.status);
        client.assert(Number(response.body.id) > 0,
            "Room ID missing");
        client.assert(
            Number(response.body.hotelId) ===
            Number(client.global.get("qaHotelId")),
            "Wrong hotel ID"
        );
    });
    if (response.status === 201) {
        client.global.set("qaRoomId", response.body.id);
    }
%}

### 11.003 — Проверяем начальный счётчик — ожидаем HTTP 200
