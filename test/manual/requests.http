### 15.036 — Нет X-Trace-Id: Gateway генерирует UUID — ожидаем HTTP 200
GET {{baseUrl}}/api/hotels
Authorization: Bearer {{adminToken}}

> {%
    client.test('Нет X-Trace-Id: Gateway генерирует UUID — HTTP 200', () => {
        client.assert(response.status === 200);
        const id = response.headers.valueOf("X-Trace-Id");
        client.assert(
            /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(id)
        );
    });
%}

