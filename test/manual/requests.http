# HOTEL BOOKING — ЕДИНЫЙ РУЧНОЙ РЕГРЕССИОННЫЙ НАБОР
# IntelliJ IDEA / HTTP Client. Весь сценарный набор находится в этом файле.
# Запуск: Eureka (8761), Gateway (8080), Booking (8081), Hotel (8082).
# Перед полным прогоном — новая H2 и готовность всех сервисов; демо-данные в зависимости от APP_DEMO_ENABLED.
# НАЧАТЬ: выполнить 01.001 регистрацию USER, 01.002 вход USER, 01.003 вход ADMIN.
# ДАЛЕЕ: запускать тесты внутри каждой секции строго сверху вниз, без пропуска подготовительных запросов.
# Успех/ошибка каждого запроса отображается в вкладке Tests IntelliJ HTTP Client (client.test).
# Идентификаторы и токены сохраняются через client.global.set; выполнять зависящие запросы в рамках одного запуска сервисов.
# Повторный прогон создающих запросов на той же H2 может закономерно дать 409; для полного прогона — чистая H2.
# Даты/идемпотентность: не переиспользуйте ключ в новом сценарии с другим телом запроса.
# Раздел 14 — отдельные инфраструктурные проверки: остановка сервисов, Eureka и повторный запуск нарушают последовательный прогон.
# Если тест зависит от реального времени, ожидания Recovery или заранее созданной сущности — это указано комментарием.
# Скрипт конкурентного тестирования: ./run-parallel-booking-test.cmd (Windows) или ./parallel-booking-test-fixed.ps1.
# Фотографии лежат рядом с этим файлом; пути в multipart отсчитываются от test/manual/.

@baseUrl = http://localhost:8080
@qaFailureCheckIn = 2054-07-10
@qaFailureCheckOut = 2054-07-12
@qaRoomId = 1
@qaCheckIn = 2054-06-10
@qaCheckOut = 2054-06-12
@qaGuestCount = 1
@s15Key = 9d7a1598-bf1d-4500-8b6f-1b4dc4715015
@idemCheckIn = 2027-04-10
@idemCheckOut = 2027-04-13
@idemKeyA = 550e8400-e29b-41d4-a716-446655441101
@idemKeyB = 550e8400-e29b-41d4-a716-446655441102
@idemKeyC = 550e8400-e29b-41d4-a716-446655441103
@idemKeyD = 550e8400-e29b-41d4-a716-446655441104


# =====================================================================================
# РАЗДЕЛ 01. Регистрация и авторизация (выполнить сначала)
# =====================================================================================

### 01.001 — Регистрация пользователя USER — ожидаем HTTP 201
# Источник: requests.http, тест №1.
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "MyPassword123",
  "username": "vova",
  "lastName": "vova",
  "firstName": "vova"
}

> {%
client.test('Регистрация тестового USER — HTTP 201', function() {
  client.assert(response.status === 201, "Ожидали 201, получили " + response.status);
});
%}

### 01.002 — Вход пользователя USER и сохранение userToken — ожидаем HTTP 200
# Источник: requests.http, тест №4.
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "MyPassword123"
}

> {%
client.test('Вход USER и данные аккаунта — HTTP 200', function() {
  client.assert(response.status === 200, "Ожидали 200, получили " + response.status);
  client.assert(response.body.username === "vova", "Неверный username в LoginResponse");
  client.assert(response.body.firstName === "vova", "Неверное имя в LoginResponse");
  client.assert(response.body.lastName === "vova", "Неверная фамилия в LoginResponse");
  client.assert(response.body.email === "test@example.com", "Неверный email в LoginResponse");
});
if (response.status === 200) {
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("userToken", response.body.accessToken);
}
%}

### 01.003 — Вход администратора ADMIN и сохранение adminToken — ожидаем HTTP 200
# Источник: requests.http, тест №7.
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
  "email": "admin@hotelbooking.com",
  "password": "1234567890art!"
}

> {%
client.test('Вход ADMIN и сохранение JWT — HTTP 200', () => client.assert(response.status === 200, "Ожидали 200, получили " + response.status));
    client.global.set("adminToken", response.body.accessToken);
%}


