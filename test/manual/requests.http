# =====================================================================================
# РАЗДЕЛ 13. ДОПОЛНИТЕЛЬНЫЕ ПРОВЕРКИ АВТОРИЗАЦИИ (ТОЛЬКО ОТДЕЛЬНО С ПАУЗАМИ)
# =====================================================================================
# ВАЖНО: запускать после успешных разделов 01–12 на ТОЙ ЖЕ H2, до раздела 15 (перезапусков).
# 01.001, 07.001, 07.009, 08.024 уже создали пользователей. Не повторяйте эти регистрации.
# Все попытки регистрации, включая 400/409, расходуют общий лимит 5/IP/час.
# Если другие тесты уже пользовались тем же IP, счётчик может быть выше указанного.
# Ниже две отдельные серии регистраций: между ними обязательно дождаться следующего часового окна.
# Нельзя запускать все дополнительные проверки без остановок в режиме «Выполнить всё».

# --- 13.А. ОТДЕЛЬНЫЕ НЕГАТИВНЫЕ ПРОВЕРКИ ВХОДА ---
# ПАУЗА ПЕРЕД ГРУППОЙ: после последнего POST /api/users/login подождите 61 секунду.
# Либо дождитесь начала следующей минуты + 2 секунды; при 429 — Retry-After + 2 секунды.
# Лимит: 20 попыток входа с одного IP за 1 минуту (ошибочные запросы тоже учитываются).
# Если аккаунт заблокирован из-за 5 неудачных паролей за 15 минут, подождите не меньше 15 минут
# согласно настройкам блокировки или Retry-After (если возвращён) перед повторной проверкой.

### 13.001 — Поле email должно пройти проверку @Email — ожидаем HTTP 400
# Username не используется для входа: 400
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
  "email": "profile_new01",
  "password": "Profile123!"
}

> {%
client.test('Поле email должно пройти проверку @Email — HTTP 400', function() {
  client.assert(response.status === 400, "Ожидали 400, получили " + response.status);
});
%}

### 13.002 — Некорректный JSON — ожидаем HTTP 400
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{"email": "broken

> {%
    client.test('Некорректный JSON — HTTP 400', () => {
        client.assert(response.status === 400);
        client.assert(response.body.code === "MALFORMED_JSON");
        client.assert(typeof response.body.traceId === "string" && response.body.traceId.length === 36);
    });
%}

### 13.003 — Неверные учётные данные — ожидаем HTTP 401
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{"email":"nobody@example.com","password":"12345678"}

> {%
    client.test('Неверные учётные данные — HTTP 401', () => {
        client.assert(response.status === 401);
        client.assert(response.body.code === "INVALID_CREDENTIALS");
        client.assert(!!response.body.traceId);
    });
%}

# --- 13.Б. НЕГАТИВНЫЕ ПРОВЕРКИ РЕГИСТРАЦИИ: ПЕРВАЯ СЕРИЯ (5 ПОПЫТОК) ---
# ПАУЗА ПЕРЕД ГРУППОЙ: после последней основной регистрации 08.024 дождитесь
# начала следующего часа + 2 секунды (например, 14:00:02), либо подождите 61 минуту.
# При 429 используйте Retry-After + 2 секунды. После паузы выполните ТОЛЬКО пять запросов ниже.
# Это проверяет ошибки регистрации (400/409), но не должно проверять сам Rate Limiting.
# Состояние H2 должно сохраняться: иначе исчезнут пользователи для проверок дубликатов.

